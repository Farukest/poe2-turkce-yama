# =====================================================================
#  Çalışma dosyaları
# =====================================================================
# work/ 330 MB; içinden yalnızca iki şey yayımlanıyor:
#   · çeviri belleği (projenin asıl çıktısı)
#   · Türkçe glif eklenmiş fontlar
# Geri kalanı oyundan yeniden üretilebilen ara dosyalar ve koşu günlükleri.
/work/*
!/work/corpus/
/work/corpus/*
!/work/corpus/bellek.jsonl
!/work/font-yamali/
/work/font-yamali/*
!/work/font-yamali/*.ttf

